# Nova HPC environment setup for Pando.
# Source from ~/.bashrc or before any apptainer / build_images.sh invocation.

# Lmod / apptainer module
source /etc/profile.d/lmod.sh 2>/dev/null
module load apptainer

# Redirect apptainer cache/tmp to /work to avoid filling /home
export APPTAINER_CACHEDIR="${PANDO_WORK_GROUP:-$HOME/work}/.apptainer/cache"
export APPTAINER_TMPDIR="${PANDO_WORK_GROUP:-$HOME/work}/.apptainer/tmp"
mkdir -p "$APPTAINER_CACHEDIR" "$APPTAINER_TMPDIR"

# Override Pando's default /scratch — Nova compute nodes have /scratch root-owned,
# but /tmp on the local NVMe is user-writable.
export SCRATCH_DIR=/tmp

# Strip module-injected /scratch:/scratch bind, replace with /tmp:/scratch.
alias pando_dev='APPTAINER_BINDPATH="${APPTAINER_BINDPATH//\/scratch:\/scratch,/}" apptainer shell -B "$(pwd):$(pwd)" -B /tmp:/scratch sifs/pando_dev.sif'
